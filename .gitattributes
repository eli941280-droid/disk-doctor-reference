# Normalize line endings: LF in the repo, converted on checkout where needed.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.zip binary
