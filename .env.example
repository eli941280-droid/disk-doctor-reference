# Copy to .env and fill in. Never commit .env itself.

# Required for real model calls. Leave empty to use the offline mock.
DISK_DOCTOR_API_KEY=

# Optional: any OpenAI-compatible endpoint.
# Defaults: https://api.deepseek.com  /  deepseek-chat
DISK_DOCTOR_BASE_URL=
DISK_DOCTOR_MODEL=

# Alternative key names, read if DISK_DOCTOR_API_KEY is empty.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
